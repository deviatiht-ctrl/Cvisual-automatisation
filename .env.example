# CVISUAL WHATSAPP GATEWAY & SAAS CONFIGURATION

PORT=3000
NODE_ENV=production

# SUPABASE CREDENTIALS (Required for database and auth)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ADMIN ACCESS
ADMIN_EMAILS=laurorejeanclarens0@gmail.com

# ANTI-BAN & DUAL-LANE ENGINE TUNING
FAST_LANE_CONCURRENCY=5
SLOW_LANE_INTERVAL_MIN_MS=600000
SLOW_LANE_JITTER_MAX_MS=360000
MAX_REMINDERS_PER_DAY=25
BATCH_PAUSE_EVERY_N=5
BATCH_PAUSE_MS=600000

# PUPPETEER CONFIGURATION
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

# PERSISTENCE DIRECTORY
AUTH_DATA_DIR=./.wwebjs_auth
